# Copy to .env and fill in the values. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Connection string for the app (Drizzle): postgresql://USER:PASSWORD@localhost:PORT/DB
# On the server (deploy/compose.yml) the host is the compose service: postgresql://USER:PASSWORD@postgres:5432/DB
DATABASE_URL=
