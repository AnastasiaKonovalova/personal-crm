# Copy to .env and fill in the values. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Connection string for the app (Drizzle): postgresql://USER:PASSWORD@localhost:PORT/DB
# On the server (deploy/compose.yml) the host is the compose service: postgresql://USER:PASSWORD@postgres:5432/DB
DATABASE_URL=

# Better Auth. Secret: a random string of 32+ characters (e.g. `openssl rand -base64 32`).
# URL: where the app is reachable (locally http://localhost:3000)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Outgoing mail (Nodemailer). Locally and in CI: Mailpit, host localhost, port 1025, no login, secure false.
# On the server: Resend SMTP, secure true
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender of login emails. The whole value goes in single quotes, otherwise docker compose cannot read .env:
# MAIL_FROM='"App name" <noreply@mail.example.com>'
MAIL_FROM=

# Email of the owner: existing contacts and groups move to this user when migration 0003 runs, the seed uses it too
OWNER_EMAIL=
