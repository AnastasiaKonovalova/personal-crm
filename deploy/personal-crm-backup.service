# Daily backup of the prod database (backup.sh), started by personal-crm-backup.timer.
# Installed into /etc/systemd/system by the owner's sudo (README, «Бэкапы и восстановление»); output goes to the
# journal: journalctl -u personal-crm-backup
[Unit]
Description=personal-crm: daily backup of the prod database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=crm-deploy
Group=crm-deploy
ExecStart=/usr/bin/bash /opt/personal-crm/backup.sh
